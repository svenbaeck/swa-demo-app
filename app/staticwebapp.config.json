{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/829133a7-3ac1-464f-88b3-9991d1e55248/v2.0",
          "clientIdSettingName": "APP_ID",
          "clientSecretSettingName": "ENTRA_ID_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.auth/*", "/*.{css,js,png,jpg,svg,ico}"]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "https://swademo.contosospace.com/.auth/login/aad"
    }
  },
  "forwardingGateway": {
    "allowedForwardedHosts": [
      "swademo.contosospace.com"
    ]
  }
}
